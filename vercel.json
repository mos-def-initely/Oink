{
  "version": 3,
  "builds": [
    {
      "src": "frontend/package.json",
      "use": "@vercel/next"
    },
    {
      "src": "backend/api.py",
      "use": "@vercel/python"
    }
  ],
  "functions": {
    "backend/api.py": {
      "runtime": "python3.13"
    }
  },
  "routes": [
    {
      "src": "/api/v1/(.*)",
      "dest": "/backend/api.py"
    }
  ]
}
